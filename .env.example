# Copy to `.env` and fill in every REQUIRED variable.
# Docker Compose reads `.env` automatically for ${VAR} substitution --
# compose.yml is the single infrastructure contract, and this file feeds it.
# Dokploy: set these in the application environment UI (it creates .env).
#
# STRICT ENV: the server validates presence of every required variable at
# boot (src/env.ts validateRequiredEnv, called from src/instrumentation.ts)
# and refuses to start if any is missing, listing the exact names. `next
# build` never needs secrets -- only the running server validates.
#
# There is exactly one bypass, meant for conscious emergency use only:
#   DANGEROUSLY_BOOT_WITH_MISSING_REQUIRED_ENV_AND_SKIP_VALIDATION=I_UNDERSTAND_THIS_MAY_CRASH_CORRUPT_DATA_OR_EXPOSE_BROKEN_BEHAVIOR
# Any other value (true, 1, yes, ...) is rejected.

# --- AI chat assistant (CopilotKit + OpenRouter) ---------------------------

# REQUIRED. OpenRouter API key used by the /api/copilotkit route
# (src/app/api/copilotkit/route.ts) to serve the AI chat widget.
# Obtain: https://openrouter.ai/keys
OPENROUTER_KEY=

# --- Contact form leads (chat widget "talk to a human" flow) ---------------

# REQUIRED. API key used by src/app/api/leads/route.ts to email new leads.
# Leads are also always persisted to disk (DATA_DIR below); the email is the
# notification channel on top. This site sends through self-hosted UseSend
# (Resend-SDK compatible), NOT Resend cloud.
# Obtain: UseSend -> Developer settings -> API Keys, scoped to the send domain.
RESEND_API_KEY=

# REQUIRED. Base URL the Resend SDK talks to. resend@6 has no constructor
# option for this -- it reads process.env.RESEND_BASE_URL at import (default
# https://api.resend.com). UseSend serves the Resend-compatible API under
# /api/v1, and the SDK appends /emails, so this MUST include that path:
# https://<instance>/api/v1 (the bare host's /emails is the web UI and 405s,
# which the SDK surfaces as a silently-failed send). Set it wherever
# RESEND_API_KEY is, or every lead email hits the wrong host.
RESEND_BASE_URL=https://usesend.devino.ca/api/v1

# --- GitHub stats (contribution graph + repo stars/forks) ------------------

# REQUIRED (presence enforced at boot by validateRequiredEnv). Read-only token
# used by src/lib/github.ts for the GraphQL contribution calendar and repo
# stats. Use a CLASSIC PAT with only the `read:user` scope -- fine-grained PATs
# have unreliable GraphQL support, so the contribution-calendar query needs a
# classic token. The code keeps an unauthenticated fallback as defense-in-depth
# (repo stars/forks via unauthenticated REST; the graph via the token-free
# github-contributions-api.jogruber.de mirror), so a token revoked at runtime
# degrades to real mirror data instead of breaking -- but the boot gate still
# requires the var to be present.
# Obtain (classic): https://github.com/settings/tokens/new  (scope: read:user)
GITHUB_TOKEN=

# --- Google Analytics (GA4) monthly active users --------------------------

# REQUIRED. Service account credentials for the GA4 Data API, used by
# src/lib/ga4.ts. Paste the full service account JSON key as a single line.
GA4_SERVICE_ACCOUNT_KEY=

# REQUIRED. GA4 property ID for each app (src/lib/ga4.ts) -- the numeric
# "property ID" from GA4 admin, one per product surfaced on the site.
GA4_PROPERTY_SHORTY=
GA4_PROPERTY_UNOTES=
GA4_PROPERTY_CARAMEL=
GA4_PROPERTY_UPUP=
GA4_PROPERTY_GETITDONE=

# --- Database (Postgres via compose) ------------------------------------------

# REQUIRED. Connection string for the Postgres instance defined in compose.yml.
# compose.yml injects this automatically from the db service; set it here only
# if running Next.js outside of compose (e.g. bare `next dev` against a local
# Postgres). The standard compose value is:
#   postgresql://portfolio:${POSTGRES_PASSWORD}@db:5432/portfolio
DATABASE_URL=

# --- Legacy persisted data root (deprecated -- kept for the transition) -------

# OPTIONAL. Was the single root for JSON/JSONL file persistence; now superseded
# by DATABASE_URL. Still read by data-dir.ts if present but no longer used by
# the main persistence paths.
DATA_DIR=

# --- Docker Compose ---------------------------------------------------------

# REQUIRED (by compose.yml, not by Next.js). Password for the Postgres service.
# Pick any strong value; compose.yml injects it into both the db service and
# the app's DATABASE_URL automatically.
POSTGRES_PASSWORD=

# --- Error tracking (self-hosted Sentry) -----------------------------------

# REQUIRED. Sentry DSN for server + edge error tracking, pointing at the
# self-hosted instance (sentry.devino.ca, project "portfolio"). The client
# DSN is a committed constant in src/instrumentation-client.ts.
SENTRY_DSN=

# --- Server-side analytics + error capture (self-hosted PostHog) ------------

# REQUIRED. Self-hosted PostHog instance used by src/lib/log.ts for
# server-side error/event capture.
POSTHOG_KEY=
POSTHOG_HOST=

# --- Client-side product analytics (browser bundle) -------------------------

# OPTIONAL (all three). No-ops when unset: the analytics simply does not load,
# so local dev and unconfigured deploys stay tracking-free. Deliberately NOT in
# REQUIRED_ENV_VARS for that reason, and distinct from the server-side
# POSTHOG_/GA4_ variables above.

# PostHog product analytics (pageviews, autocapture) via posthog-js, initialized
# in src/instrumentation-client.ts. Use the PUBLIC project key (phc_..., safe to
# ship in the browser) -- NOT the server-side POSTHOG_KEY. Host defaults to
# https://posthog.devino.ca when only the key is set.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Google Analytics gtag.js measurement ID (format G-XXXXXXXXXX), wired in
# src/components/analytics/google-analytics.tsx. This is the client tracking tag,
# separate from the server-side GA4 Data API reporting (GA4_* above).
NEXT_PUBLIC_GA4_ID=
