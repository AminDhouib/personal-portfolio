# Copy to .env.local and fill in what you need.
#
# Nothing here is required to run the site locally — every integration below
# degrades gracefully when its variable is missing (the feature just goes
# quiet or falls back to an unauthenticated/public data source). See the
# comment above each variable for the exact fallback behavior.

# --- AI chat assistant (CopilotKit + OpenRouter) ---------------------------

# OpenRouter API key used by the /api/copilotkit route (src/app/api/copilotkit/route.ts).
# Required only for the AI chat widget: without it, POST /api/copilotkit
# returns 503 with { "error": "OPENROUTER_KEY not configured" }. The rest of
# the site is unaffected.
OPENROUTER_KEY=

# --- Contact form leads (chat widget "talk to a human" flow) ---------------

# Resend API key used by src/app/api/leads/route.ts to email new leads.
# Optional: leads are always persisted to disk (LEADS_DATA_DIR below) and
# logged to stdout as JSON regardless of this key. Without it, no
# notification email is sent — the request still succeeds as long as the
# on-disk write does.
RESEND_API_KEY=

# --- GitHub stats (contribution graph + repo stars/forks) ------------------

# Personal access token used by src/lib/github.ts.
# Optional: without it, repo stats fall back to the unauthenticated GitHub
# REST API (lower rate limit), and the contribution graph falls back from the
# authenticated GraphQL calendar to a token-free public mirror
# (github-contributions-api.jogruber.de) so the graph still renders real data.
GITHUB_TOKEN=

# --- Google Analytics (GA4) monthly active users --------------------------

# Service account credentials for the GA4 Data API, used by src/lib/ga4.ts.
# Paste the full service account JSON key as a single line.
# Optional: without it, fetchMAU()/fetchAllMAU() return null for every app
# (MAU stats simply don't render).
GA4_SERVICE_ACCOUNT_KEY=

# GA4 property ID for each app (src/lib/ga4.ts). Each is optional
# independently — an app with no property ID just reports null MAU while the
# others still resolve normally (assuming GA4_SERVICE_ACCOUNT_KEY is set).
GA4_PROPERTY_SHORTY=
GA4_PROPERTY_UNOTES=
GA4_PROPERTY_CARAMEL=
GA4_PROPERTY_UPUP=
GA4_PROPERTY_GETITDONE=

# --- Persisted data root -----------------------------------------------------

# Single root for everything persisted to disk (src/lib/data-dir.ts):
# leaderboard.json, password-game-leaderboard.json, leads.jsonl.
# Optional BY DESIGN (the sanctioned exception to strict env validation — see
# DESIGN.md register): it is a path override with a safe default of
# <cwd>/.data. In production that directory is the `portfolio-data` volume
# mounted at /app/.data (see README > Deployment) — without that volume,
# persisted data is lost on every redeploy. Tests point this at an OS temp
# directory per suite.
DATA_DIR=

# --- Error tracking (self-hosted Sentry / GlitchTip) ----------------------

# Sentry DSN for error tracking (server + client). Points to the self-hosted
# Sentry instance at sentry.devino.ca. Optional: when unset, Sentry SDK
# initializes but does not send events.
SENTRY_DSN=

# --- Optional server-side error capture (self-hosted PostHog) --------------

# Self-hosted PostHog instance for server-side error/event capture.
# Optional: this feature is a no-op when unset.
# POSTHOG_KEY=
# POSTHOG_HOST=
