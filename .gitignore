/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
debug.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# superpowers brainstorm files
.superpowers/
/.data

# session screenshots & QA artifacts
.claude/*.png
.claude/*.local.*
.claude/*.lock
.qa-*.png
snapshot2.txt.*.png

# local graph/codebase analysis artifacts
**/graphify-out/
.graphify*

# stray monitor output (unrelated to this project)
aishorty-monitor.*

# stray junk files
nul
.devserver.log
element_clones/
