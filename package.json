{
  "name": "personal-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "docker compose up --build",
    "build": "next build",
    "build:docker": "docker compose build app",
    "start": "docker compose up -d",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,mjs,json}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,mjs,json}\" \".github/**/*.{yml,yaml}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.50",
    "@copilotkit/react-core": "^1.62.3",
    "@copilotkit/react-ui": "^1.62.3",
    "@copilotkit/runtime": "^1.62.3",
    "@google-analytics/data": "^5.2.1",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@sentry/nextjs": "^10.65.0",
    "chess.js": "^1.4.0",
    "framer-motion": "^12.42.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "posthog-js": "^1.399.2",
    "posthog-node": "^5.41.0",
    "postprocessing": "^6.39.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.4",
    "rehype-slug": "^6.0.0",
    "resend": "^6.17.2",
    "shiki": "^4.3.1",
    "simple-icons": "^16.26.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-plugin-oxlint": "^1.73.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.26.0",
    "lint-staged": "^17.0.8",
    "oxlint": "^1.73.0",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,mts}": [
      "prettier --write",
      "oxlint -c .oxlintrc.json"
    ],
    "*.{css,json,md,yml,yaml,mjs}": [
      "prettier --write"
    ]
  }
}
