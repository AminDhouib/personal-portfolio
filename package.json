{
  "name": "personal-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "docker compose up --build",
    "build": "next build",
    "build:docker": "docker compose build app",
    "start": "docker compose up -d",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --coverage --project unit",
    "test:perf": "vitest run --project perf",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{ts,mjs,json}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{ts,mjs,json}\" \".github/**/*.{yml,yaml}\"",
    "prepare": "husky",
    "lighthouse": "node scripts/run-lighthouse.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.131",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@copilotkit/react-core": "^1.79.1",
    "@copilotkit/react-ui": "^1.79.1",
    "@copilotkit/runtime": "^1.79.1",
    "@google-analytics/data": "^7.3.0",
    "@lezer/highlight": "^1.2.5",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.1",
    "@sentry/nextjs": "^10.76.2",
    "chess.js": "^1.4.0",
    "framer-motion": "^12.38.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "posthog-js": "^1.438.13",
    "posthog-node": "^5.56.2",
    "postprocessing": "^6.39.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "shiki": "^4.5.0",
    "simple-icons": "^16.35.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-oxlint": "^1.89.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{ts,tsx,mts}": [
      "prettier --write",
      "oxlint -c .oxlintrc.json"
    ],
    "*.{css,json,md,yml,yaml,mjs}": [
      "prettier --write"
    ]
  }
}
