{
  "name": "personal-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "docker compose up --build",
    "build": "next build",
    "build:docker": "docker compose build app",
    "start": "docker compose up -d",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,mjs,json}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,mjs,json}\" \".github/**/*.{yml,yaml}\"",
    "prepare": "husky",
    "lighthouse": "node scripts/run-lighthouse.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.50",
    "@copilotkit/react-core": "^1.69.3",
    "@copilotkit/react-ui": "^1.69.3",
    "@copilotkit/runtime": "^1.69.3",
    "@google-analytics/data": "^5.2.1",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@sentry/nextjs": "^10.63.0",
    "chess.js": "^1.4.0",
    "framer-motion": "^12.38.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "posthog-js": "^1.422.5",
    "posthog-node": "^5.51.4",
    "postprocessing": "^6.39.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "resend": "^6.25.0",
    "shiki": "^4.4.3",
    "simple-icons": "^16.29.0",
    "three": "^0.185.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-oxlint": "^1.80.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "knip": "^6.33.0",
    "lint-staged": "^17.4.1",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,mts}": [
      "prettier --write",
      "oxlint -c .oxlintrc.json"
    ],
    "*.{css,json,md,yml,yaml,mjs}": [
      "prettier --write"
    ]
  }
}
